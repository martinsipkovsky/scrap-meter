# Copy to .env and adjust. docker-compose reads this automatically.

# Database
POSTGRES_USER=cognex
POSTGRES_PASSWORD=cognex
POSTGRES_DB=cognex

# Web
WEB_PORT=8000
# Used to sign session cookies. Change this to a long random string in production.
SECRET_KEY=change-me-in-production

# Seeded on first startup only (ignored once the account exists)
DEFAULT_ADMIN_USER=Admin
DEFAULT_ADMIN_PASSWORD=1234

# Background poller that reads the devices on their intervals
POLL_ENABLED=true

# Listeners (TCP, UDP, SLMP server): port range published for devices that push data.
# Each listening device uses one port from this range. Open it in the firewall.
LISTEN_PORTS=5100-5119

# Optional: Power BI / Excel read the data with a read-only login. Only used
# with docker-compose.powerbi.yml (copied as docker-compose.override.yml), which
# also publishes the database on POWERBI_DB_PORT. See docs/reporting.md.
#POWERBI_PASSWORD=
#POWERBI_DB_PORT=5432
